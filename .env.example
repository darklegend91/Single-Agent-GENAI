# Copy to .env and replace the sample local tokens. No production credential is defaulted.
KA_CREDENTIAL_MAPPING={"REPLACE_WITH_RANDOM_BEARER_TOKEN":{"subject":"analyst","customer_ids":["U0000000001"],"ingest_admin":false},"REPLACE_WITH_RANDOM_ADMIN_TOKEN":{"subject":"operator","customer_ids":[],"ingest_admin":true}}
KA_DATASET_PATH=dataset/customer.csv
KA_DATABASE_PATH=output/customers.sqlite3
KA_ACTIVE_MANIFEST_PATH=output/active.json
KA_STAGING_DIR=output/staging
KA_INGESTION_BATCH_SIZE=1000
# Explicit source-field to strptime-format mapping; leave unresolved timestamps unresolved.
KA_TIMESTAMP_FORMATS={}
KA_LLM_PROVIDER=ollama
KA_OLLAMA_BASE_URL=http://127.0.0.1:11434
KA_MODEL_ID=ollama:qwen3:4b-instruct
KA_EMBEDDING_PROVIDER=ollama
KA_EMBEDDING_MODEL=nomic-embed-text:latest
KA_EMBEDDING_DIMENSIONS=768
KA_MILVUS_URI=output/milvus.db
KA_MILVUS_COLLECTION=customer_knowledge
KA_LANGFUSE_BASE_URL=https://cloud.langfuse.com
KA_RATE_LIMIT_PER_MINUTE=60
KA_REQUEST_TIMEOUT_SECONDS=120
KA_TOP_K=3
KA_MAX_DOCUMENTS=3
KA_CONTEXT_MAX_CHARS=12000
KA_CONTEXT_MAX_TOKENS=4000

KA_LANGFUSE_SECRET_KEY=
KA_LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
